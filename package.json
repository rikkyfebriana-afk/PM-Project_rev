{
  "name": "project-control-center",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint app components hooks lib prisma scripts proxy.ts next.config.ts prisma.config.ts eslint.config.mjs postcss.config.mjs",
    "format": "oxfmt --write app components hooks lib prisma scripts proxy.ts next.config.ts prisma.config.ts eslint.config.mjs postcss.config.mjs",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "storage:configure": "tsx scripts/configure-storage.ts"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@shadcn/react": "0.3.0",
    "@supabase/supabase-js": "2.116.0",
    "bcryptjs": "3.0.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "4.1.0",
    "dotenv": "17.2.3",
    "embla-carousel-react": "8.5.2",
    "input-otp": "1.4.2",
    "leaflet": "1.9.4",
    "lucide-react": "1.31.0",
    "next": "16.3.4",
    "pg": "8.16.3",
    "react": "19.2.6",
    "react-day-picker": "9.8.1",
    "react-dom": "19.2.6",
    "react-leaflet": "5.0.0",
    "react-resizable-panels": "4.5.8",
    "recharts": "3.8.0",
    "shadcn": "4.18.0",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/leaflet": "1.9.22",
    "@types/node": "22.19.19",
    "@types/pg": "8.15.6",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.1",
    "eslint-config-next": "16.3.4",
    "oxfmt": "0.61.0",
    "prisma": "7.10.0",
    "tailwindcss": "4.2.1",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.56.1"
  },
  "type": "module"
