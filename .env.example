# PostgreSQL: use the pooled URL at runtime and direct URL for migrations.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require"

# Authentication (server-only)
AUTH_SECRET="replace-with-at-least-32-random-bytes"
SESSION_COOKIE_NAME="__Host-pcc_session"
SESSION_TTL_DAYS="7"
APP_URL="http://localhost:3000"

# Supabase Storage (server-only; bucket must stay private)
SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="replace-with-service-role-key"
SUPABASE_STORAGE_BUCKET="project-documents"
MAX_UPLOAD_BYTES="26214400"

# Initial admin used only by `pnpm db:seed`
SEED_ADMIN_USERNAME="admin"
SEED_ADMIN_PASSWORD="replace-with-a-strong-password"
SEED_ADMIN_DISPLAY_NAME="System Administrator"

# Local-only dashboard preview. Production code ignores this flag.
DEMO_MODE="false"
