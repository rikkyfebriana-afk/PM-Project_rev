generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  PROJECT_MANAGER
  VIEWER
}

enum ProjectStatus {
  ACTIVE
  ON_HOLD
  CLOSED
  CANCELLED
}

enum ProjectHealth {
  ON_TRACK
  ATTENTION
  CRITICAL
}

enum ProjectPhase {
  PLANNING
  ENGINEERING
  PROCUREMENT
  PRODUCTION
  FAT
  DELIVERY
  INSTALLATION
  BAST
  CLOSED
}

enum BoqStatus {
  DRAFT
  APPROVED
  SUPERSEDED
}

enum BoqItemType {
  MATERIAL
  SERVICE
  OTHER
}

enum MaterialStatus {
  PLANNED
  ORDERED
  PARTIAL
  RECEIVED
  INSTALLED
  SHORTAGE
}

enum MilestoneStatus {
  UPCOMING
  AT_RISK
  OVERDUE
  COMPLETED
}

enum ActionPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ActionStatus {
  OPEN
  IN_PROGRESS
  BLOCKED
  RESOLVED
}

enum DocumentCategory {
  BOQ
  PURCHASE_ORDER
  PROGRESS_PHOTO
  FAT
  DELIVERY_ORDER
  BAST
  CONTRACT
  OTHER
}

enum DocumentStatus {
  PENDING
  READY
  FAILED
}

model User {
  id                 String          @id @default(cuid())
  username           String
  normalizedUsername String          @unique
  displayName        String
  passwordHash       String
  role               UserRole        @default(VIEWER)
  isActive           Boolean         @default(true)
  failedLoginCount   Int             @default(0)
  lockedUntil        DateTime?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  sessions           Session[]
  managedProjects    Project[]       @relation("ProjectManager")
  projectMemberships ProjectMember[]
  assignedActions    ActionItem[]    @relation("ActionAssignee")
  uploadedDocuments  Document[]
  auditLogs          AuditLog[]
  createdBoqs        Boq[]           @relation("BoqCreatedBy")
  approvedBoqs       Boq[]           @relation("BoqApprovedBy")

  @@index([isActive])
}

model Session {
  id         String    @id @default(cuid())
  tokenHash  String    @unique
  userId     String
  expiresAt  DateTime
  lastSeenAt DateTime?
  userAgent  String?
  ipHash     String?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Project {
  id               String          @id @default(cuid())
  code             String          @unique
  name             String
  clientName       String?
  status           ProjectStatus   @default(ACTIVE)
  health           ProjectHealth   @default(ON_TRACK)
  phase            ProjectPhase    @default(PLANNING)
  progressPct      Decimal         @default(0) @db.Decimal(5, 2)
  poValue          Decimal         @default(0) @db.Decimal(18, 2)
  budgetValue      Decimal         @default(0) @db.Decimal(18, 2)
  actualCost       Decimal         @default(0) @db.Decimal(18, 2)
  forecastCost     Decimal         @default(0) @db.Decimal(18, 2)
  costOpeningBalance Decimal       @default(0) @db.Decimal(18, 2)
  address          String?
  latitude         Decimal?        @db.Decimal(9, 6)
  longitude        Decimal?        @db.Decimal(9, 6)
  plannedStart     DateTime?       @db.Date
  plannedFinish    DateTime?       @db.Date
  actualFinish     DateTime?       @db.Date
  projectManagerId String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  deletedAt        DateTime?
  projectManager   User?           @relation("ProjectManager", fields: [projectManagerId], references: [id])
  members          ProjectMember[]
  boqs             Boq[]
  materials        Material[]
  milestones       Milestone[]
  actionItems      ActionItem[]
  documents        Document[]
  auditLogs        AuditLog[]
  costEntries      CostEntry[]

  @@index([status, health])
  @@index([projectManagerId])
  @@index([plannedFinish])
}

model ProjectMember {
  id        String   @id @default(cuid())
  projectId String
  userId    String
  createdAt DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([userId])
}

model Boq {
  id               String    @id @default(cuid())
  projectId        String
  createdById      String?
  approvedById     String?
  sourceDocumentId String?   @unique
  version          Int
  status           BoqStatus @default(DRAFT)
  sourceHash       String?
  sourceFileName   String?
  sourceSheetName  String?
  approvedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  project          Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy        User?     @relation("BoqCreatedBy", fields: [createdById], references: [id])
  approvedBy       User?     @relation("BoqApprovedBy", fields: [approvedById], references: [id])
  sourceDocument   Document? @relation(fields: [sourceDocumentId], references: [id])
  items            BoqItem[]

  @@unique([projectId, version])
  @@unique([projectId, sourceHash])
  @@index([projectId, status])
  @@index([createdById])
  @@index([approvedById])
}

model BoqItem {
  id          String      @id @default(cuid())
  boqId       String
  itemType    BoqItemType @default(MATERIAL)
  sortOrder   Int         @default(0)
  itemNo      String
  itemCode    String?
  description String
  unit        String
  quantity    Decimal     @db.Decimal(18, 4)
  unitPrice   Decimal     @db.Decimal(18, 2)
  lineTotal   Decimal     @db.Decimal(18, 2)
  boq         Boq         @relation(fields: [boqId], references: [id], onDelete: Cascade)
  material    Material?

  @@unique([boqId, itemNo])
  @@index([boqId])
}

model Material {
  id               String         @id @default(cuid())
  projectId        String
  boqItemId        String?        @unique
  code             String?
  normalizedCode   String?
  description      String
  unit             String
  requiredQty      Decimal        @db.Decimal(18, 4)
  orderedQty       Decimal        @default(0) @db.Decimal(18, 4)
  receivedQty      Decimal        @default(0) @db.Decimal(18, 4)
  installedQty     Decimal        @default(0) @db.Decimal(18, 4)
  supplier         String?
  purchaseOrderNo  String?
  needByDate       DateTime?      @db.Date
  estimatedArrival DateTime?      @db.Date
  status           MaterialStatus @default(PLANNED)
  isActive         Boolean        @default(true)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  project          Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  boqItem          BoqItem?       @relation(fields: [boqItemId], references: [id])
  documents        Document[]

  @@unique([projectId, normalizedCode])
  @@index([projectId, status])
  @@index([projectId, isActive])
  @@index([needByDate])
}

model Milestone {
  id          String          @id @default(cuid())
  projectId   String
  title       String
  phase       ProjectPhase?
  plannedDate DateTime        @db.Date
  completedAt DateTime?
  progressPct Decimal         @default(0) @db.Decimal(5, 2)
  status      MilestoneStatus @default(UPCOMING)
  notes       String?
  referenceNo String?
  responsible String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  project     Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  documents   Document[]
  punchItems  ActionItem[]

  @@index([projectId, plannedDate])
  @@index([status, plannedDate])
}

model ActionItem {
  id          String         @id @default(cuid())
  projectId   String
  title       String
  description String?
  priority    ActionPriority @default(MEDIUM)
  status      ActionStatus   @default(OPEN)
  dueAt       DateTime?
  assigneeId  String?
  resolvedAt  DateTime?
  milestoneId String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  project     Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignee    User?          @relation("ActionAssignee", fields: [assigneeId], references: [id])
  milestone   Milestone?     @relation(fields: [milestoneId], references: [id])

  @@index([projectId, status])
  @@index([assigneeId, status])
  @@index([priority, dueAt])
  @@index([milestoneId, status])
}

model CostEntry {
  id String @id @default(cuid())
  projectId String
  requestId String @unique
  category String
  description String
  referenceNo String?
  amount Decimal @db.Decimal(18, 2)
  spentAt DateTime @db.Date
  createdAt DateTime @default(now())
  voidedAt DateTime?
  voidReason String?
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, spentAt])
}

model Document {
  id           String           @id @default(cuid())
  projectId    String
  milestoneId  String?
  materialId   String?
  uploadedById String
  category     DocumentCategory
  status       DocumentStatus   @default(PENDING)
  originalName String
  bucket       String
  objectKey    String
  mimeType     String
  sizeBytes    BigInt
  checksum     String?
  createdAt    DateTime         @default(now())
  deletedAt    DateTime?
  project      Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  milestone    Milestone?       @relation(fields: [milestoneId], references: [id])
  material     Material?        @relation(fields: [materialId], references: [id])
  uploadedBy   User             @relation(fields: [uploadedById], references: [id])
  sourceBoq    Boq?

  @@unique([bucket, objectKey])
  @@index([projectId, category, status])
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  projectId  String?
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  ipHash     String?
  createdAt  DateTime @default(now())
  user       User?    @relation(fields: [userId], references: [id])
  project    Project? @relation(fields: [projectId], references: [id])

  @@index([projectId, createdAt])
  @@index([userId, createdAt])
  @@index([entityType, entityId])
}
